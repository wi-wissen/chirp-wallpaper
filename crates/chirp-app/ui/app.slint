// Chirp Wallpaper: main window.
// Windows 11 look via Slint's "fluent" style; follows light and dark mode.
// All visible text comes from the `Tr` global, filled from the Fluent files.

import { Button, Switch, ComboBox, ScrollView, Palette, Spinner } from "std-widgets.slint";

export global Tr {
    in property <string> nav-today: "Today";
    in property <string> nav-history: "History";
    in property <string> nav-settings: "Settings";
    in property <string> nav-about: "About";
    in property <string> today-update: "Update now";
    in property <string> today-more: "Learn more";
    in property <string> today-empty: "No picture yet.";
    in property <string> today-loading: "Loading today’s picture …";
    in property <string> today-updating: "Updating …";
    in property <string> history-open: "Open";
    in property <string> settings-appearance: "Appearance";
    in property <string> settings-fit: "Fit";
    in property <string> settings-screens: "Screens";
    in property <string> settings-caption: "Write description into picture";
    in property <string> settings-caption-desc: "";
    in property <string> settings-caption-position: "Position of the description";
    in property <string> settings-save: "Keep pictures";
    in property <string> settings-save-desc: "";
    in property <string> settings-data: "Data";
    in property <string> settings-clear: "Remove stored data";
    in property <string> settings-clear-desc: "";
    in property <string> settings-clear-button: "Remove …";
    in property <string> clear-confirm-title: "Remove stored data?";
    in property <string> clear-confirm-text: "";
    in property <string> settings-unsetup: "Remove setup for all users";
    in property <string> settings-unsetup-desc: "";
    in property <string> unsetup-confirm-title: "Remove setup for all users?";
    in property <string> unsetup-confirm-text: "";
    in property <string> remove-button: "Remove";
    in property <string> history-empty: "Pictures of the last days appear here.";
    in property <string> history-use: "Use";
    in property <string> settings-general: "General";
    in property <string> settings-autostart: "Start with Windows";
    in property <string> settings-autostart-desc: "";
    in property <string> settings-desktop: "Desktop background";
    in property <string> settings-lockscreen: "Lock screen";
    in property <string> settings-lockscreen-desc: "";
    in property <string> settings-picture: "Picture";
    in property <string> settings-region: "Picture region";
    in property <string> settings-region-desc: "";
    in property <string> settings-resolution: "Resolution";
    in property <string> settings-pause: "Pause picture changes";
    in property <string> settings-pause-desc: "";
    in property <string> settings-admin: "All users";
    in property <string> settings-admin-title: "Set up for all users";
    in property <string> settings-admin-desc: "";
    in property <string> settings-admin-button: "Set up …";
    in property <string> admin-confirm-title: "Set up for all users?";
    in property <string> admin-confirm-intro: "";
    in property <string> admin-step-copy: "";
    in property <string> admin-step-lock: "";
    in property <string> admin-step-signin: "";
    in property <string> admin-confirm-uac: "";
    in property <string> admin-confirm-ok: "Continue";
    in property <string> cancel: "Cancel";
    in property <string> label-baseline: "Baseline picture";
    in property <string> about-text: "";
    in property <string> about-website: "Website";
    in property <string> about-source: "Source code";
}

export struct HistoryItem {
    thumb: image,
    title: string,
    date: string,
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <image> icon;
    callback clicked;
    height: 36px;
    border-radius: 4px;
    background: root.selected ? Palette.foreground.transparentize(0.92) : touch.has-hover ? Palette.foreground.transparentize(0.95) : transparent;
    accessible-role: button;
    accessible-label: root.text;
    if root.selected: Rectangle {
        x: 0;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 1.5px;
        background: Palette.accent-background;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: start;
        Image {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            source: root.icon;
            colorize: Palette.foreground;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 14px;
            color: Palette.foreground;
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Like the rows in the Windows 11 settings: light surface, barely visible edge.
component Card inherits Rectangle {
    background: Palette.color-scheme == ColorScheme.dark ? #ffffff0d : #ffffffb3;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.color-scheme == ColorScheme.dark ? #ffffff10 : #0000000f;
}

// Text the user can select and copy (Ctrl+C), e.g. to search for the place.
component SelectableText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    font-size: 14px;
    color: Palette.foreground;
    selection-background-color: Palette.accent-background.transparentize(0.6);
    selection-foreground-color: Palette.foreground;
}

component Row inherits Rectangle {
    in property <string> title;
    in property <string> description;
    background: Palette.color-scheme == ColorScheme.dark ? #ffffff0d : #ffffffb3;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.color-scheme == ColorScheme.dark ? #ffffff10 : #0000000f;
    min-height: 62px;
    HorizontalLayout {
        padding: 12px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 14px;
                color: Palette.foreground;
                wrap: word-wrap;
            }
            if root.description != "": Text {
                text: root.description;
                font-size: 12px;
                color: Palette.foreground.transparentize(0.35);
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Palette.foreground;
}

export component AppWindow inherits Window {
    title: "Chirp Wallpaper";
    icon: @image-url("../../../assets/icon-64.png");
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 520px;
    background: Palette.background;

    in-out property <int> page: 0;
    in property <string> version;
    in property <bool> is-windows: true;

    // Today
    in property <bool> has-picture;
    in property <image> picture;
    in property <string> pic-title;
    in property <string> pic-caption;
    in property <string> pic-meta;
    in property <string> pic-copyright;
    in property <string> pic-description;
    in property <bool> has-info-url;
    in property <string> status-text;
    in property <bool> status-is-error;
    in property <bool> busy;
    in property <string> baseline-text;

    // History
    in property <[HistoryItem]> history;

    // Settings
    in-out property <bool> autostart;
    in-out property <bool> desktop;
    in-out property <bool> lockscreen;
    in property <[string]> regions;
    in-out property <int> region-index;
    in property <[string]> resolutions: ["4K (UHD)", "Full HD (1080p)"];
    in-out property <int> resolution-index;
    in property <[string]> pause-options;
    in-out property <int> pause-index;
    in property <[string]> fits;
    in-out property <int> fit-index;
    in property <[string]> screen-options;
    in-out property <int> screens-index;
    in-out property <bool> caption;
    in property <[string]> corners;
    in-out property <int> corner-index;
    in-out property <bool> save-copies;

    in property <string> toast;
    in-out property <bool> confirm-admin;
    // 1: remove my stored data, 2: remove the setup for all users
    in-out property <int> confirm-remove;
    in property <bool> machine-setup;

    callback update-now();
    callback open-info();
    callback use-history(int);
    callback open-history(int);
    callback display-changed();
    callback clear-data();
    callback remove-machine();
    callback settings-changed();
    callback pause-changed();
    callback setup-machine();
    callback open-website();
    callback open-source();

    HorizontalLayout {
        // Navigation
        Rectangle {
            width: 240px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                HorizontalLayout {
                    padding: 10px;
                    padding-bottom: 14px;
                    spacing: 10px;
                    Image {
                        source: @image-url("../../../assets/icon-32.png");
                        width: 24px;
                        height: 24px;
                    }
                    Text {
                        text: "Chirp Wallpaper";
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: Palette.foreground;
                    }
                }
                NavItem {
                    text: Tr.nav-today;
                    selected: root.page == 0;
                    icon: @image-url("icons/image.svg");
                    clicked => {
                        root.page = 0;
                    }
                }
                NavItem {
                    text: Tr.nav-history;
                    selected: root.page == 1;
                    icon: @image-url("icons/history.svg");
                    clicked => {
                        root.page = 1;
                    }
                }
                NavItem {
                    text: Tr.nav-settings;
                    selected: root.page == 2;
                    icon: @image-url("icons/settings.svg");
                    clicked => {
                        root.page = 2;
                    }
                }
                Rectangle { }
                NavItem {
                    text: Tr.nav-about;
                    selected: root.page == 3;
                    icon: @image-url("icons/info.svg");
                    clicked => {
                        root.page = 3;
                    }
                }
            }
        }

        // Content
        Rectangle {
            horizontal-stretch: 1;

            // Today: picture on top, text and buttons below. Nothing sits side
            // by side with the picture, so wide fonts or high scaling cannot push
            // anything out of the window.
            if root.page == 0: sv0 := ScrollView {
                content-width: self.visible-width;
                content-height: today.preferred-height;
                today := VerticalLayout {
                    width: sv0.visible-width;
                    padding: 32px;
                    padding-top: 24px;
                    spacing: 14px;
                    Text {
                        text: Tr.nav-today;
                        font-size: 28px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    HorizontalLayout {
                        alignment: start;
                        // Monitor-like frame, as in the mockup. Its size follows the
                        // window's width and height, so picture, text and buttons
                        // are visible without scrolling; at most 720 px wide.
                        Rectangle {
                            width: min(min(sv0.visible-width - 64px, 720px), max(240px, (sv0.visible-height - 380px) * 16 / 9));
                            height: self.width * 9 / 16;
                            border-radius: 10px;
                            background: Palette.color-scheme == ColorScheme.dark ? #3a3a3a : #1b1b1b;
                            Rectangle {
                                x: 4px;
                                y: 4px;
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                border-radius: 7px;
                                clip: true;
                                background: Palette.alternate-background;
                                if root.has-picture: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.picture;
                                    image-fit: cover;
                                }
                                if !root.has-picture && root.busy: VerticalLayout {
                                    alignment: center;
                                    spacing: 12px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Spinner {
                                            indeterminate: true;
                                            width: 32px;
                                            height: 32px;
                                        }
                                    }
                                    Text {
                                        text: Tr.today-loading;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        color: Palette.foreground.transparentize(0.35);
                                    }
                                }
                                if !root.has-picture && !root.busy: Text {
                                    text: Tr.today-empty;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width - 32px;
                                    color: Palette.foreground.transparentize(0.35);
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        if root.pic-meta != "": Text {
                            text: root.pic-meta;
                            font-size: 12px;
                            wrap: word-wrap;
                            color: Palette.foreground.transparentize(0.35);
                        }
                        if root.pic-title != "": SelectableText {
                            text: root.pic-title;
                            font-size: 22px;
                            font-weight: 600;
                        }
                        if root.pic-caption != "": SelectableText {
                            text: root.pic-caption;
                        }
                        if root.pic-copyright != "": SelectableText {
                            text: root.pic-copyright;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(0.35);
                        }
                    }
                    // Buttons side by side, or below each other when space is short.
                    if sv0.visible-width - 64px >= 420px: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button {
                            text: root.busy ? Tr.today-updating : Tr.today-update;
                            icon: @image-url("icons/arrow_sync.svg");
                            colorize-icon: true;
                            primary: true;
                            enabled: !root.busy;
                            clicked => {
                                root.update-now();
                            }
                        }
                        if root.has-info-url: Button {
                            text: Tr.today-more;
                            icon: @image-url("icons/open.svg");
                            colorize-icon: true;
                            clicked => {
                                root.open-info();
                            }
                        }
                    }
                    if sv0.visible-width - 64px < 420px: VerticalLayout {
                        spacing: 8px;
                        Button {
                            text: root.busy ? Tr.today-updating : Tr.today-update;
                            icon: @image-url("icons/arrow_sync.svg");
                            colorize-icon: true;
                            primary: true;
                            enabled: !root.busy;
                            clicked => {
                                root.update-now();
                            }
                        }
                        if root.has-info-url: Button {
                            text: Tr.today-more;
                            icon: @image-url("icons/open.svg");
                            colorize-icon: true;
                            clicked => {
                                root.open-info();
                            }
                        }
                    }
                    if root.status-text != "": Rectangle {
                        border-radius: 6px;
                        background: root.status-is-error ? #f6a10022 : Palette.accent-background.transparentize(0.85);
                        HorizontalLayout {
                            padding: 12px;
                            padding-left: 16px;
                            Text {
                                text: root.status-text;
                                wrap: word-wrap;
                                font-size: 13px;
                                color: Palette.foreground;
                            }
                        }
                    }
                    if root.pic-description != "": SelectableText {
                        text: root.pic-description;
                        font-size: 14px;
                    }
                    if root.baseline-text != "": Text {
                        text: root.baseline-text;
                        font-size: 12px;
                        wrap: word-wrap;
                        color: Palette.foreground.transparentize(0.35);
                    }
                }
            }

            // History
            if root.page == 1: Rectangle {
                property <length> gap: 12px;
                property <length> avail: self.width - 64px;
                // Three columns when there is room, otherwise two or one.
                property <int> cols: avail >= 800px ? 3 : avail >= 500px ? 2 : 1;
                property <length> tile-w: min(420px, (avail - (cols - 1) * gap) / cols);
                property <length> info-h: 108px;
                property <length> tile-h: tile-w * 9 / 16 + info-h;
                VerticalLayout {
                    padding: 32px;
                    padding-top: 24px;
                    spacing: 16px;
                    Text {
                        text: Tr.nav-history;
                        font-size: 28px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    if root.history.length == 0: Text {
                        text: Tr.history-empty;
                        color: Palette.foreground.transparentize(0.35);
                    }
                    Flickable {
                        content-height: (Math.ceil(root.history.length / cols) * (tile-h + gap));
                        for item[i] in root.history: Card {
                            x: Math.mod(i, cols) * (tile-w + gap);
                            y: Math.floor(i / cols) * (tile-h + gap);
                            width: tile-w;
                            height: tile-h;
                            clip: true;
                            Image {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.width * 9 / 16;
                                source: item.thumb;
                                image-fit: cover;
                            }
                            VerticalLayout {
                                y: parent.width * 9 / 16;
                                height: info-h;
                                alignment: start;
                                padding: 12px;
                                padding-top: 8px;
                                spacing: 6px;
                                VerticalLayout {
                                    Text {
                                        text: item.title;
                                        font-size: 13px;
                                        overflow: elide;
                                        color: Palette.foreground;
                                    }
                                    Text {
                                        text: item.date;
                                        font-size: 11px;
                                        color: Palette.foreground.transparentize(0.35);
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: Tr.history-use;
                                        clicked => {
                                            root.use-history(i);
                                        }
                                    }
                                    Button {
                                        text: Tr.history-open;
                                        icon: @image-url("icons/open.svg");
                                        colorize-icon: true;
                                        clicked => {
                                            root.open-history(i);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Settings
            if root.page == 2: sv2 := ScrollView {
                content-width: self.visible-width;
                content-height: settings.preferred-height;
                settings := VerticalLayout {
                    width: sv2.visible-width;
                    padding: 32px;
                    padding-top: 24px;
                    spacing: 6px;
                    Text {
                        text: Tr.nav-settings;
                        font-size: 28px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    SectionTitle {
                        text: Tr.settings-general;
                    }
                    VerticalLayout {
                        VerticalLayout {
                            spacing: 4px;
                            Row {
                                title: Tr.settings-autostart;
                                description: Tr.settings-autostart-desc;
                                Switch {
                                    checked <=> root.autostart;
                                    toggled => {
                                        root.settings-changed();
                                    }
                                }
                            }
                            Row {
                                title: Tr.settings-desktop;
                                Switch {
                                    checked <=> root.desktop;
                                    toggled => {
                                        root.settings-changed();
                                    }
                                }
                            }
                            Row {
                                title: Tr.settings-lockscreen;
                                description: Tr.settings-lockscreen-desc;
                                Switch {
                                    checked <=> root.lockscreen;
                                    toggled => {
                                        root.settings-changed();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 10px;
                    }
                    SectionTitle {
                        text: Tr.settings-picture;
                    }
                    VerticalLayout {
                        VerticalLayout {
                            spacing: 4px;
                            Row {
                                title: Tr.settings-region;
                                description: Tr.settings-region-desc;
                                ComboBox {
                                    width: 260px;
                                    model: root.regions;
                                    current-index <=> root.region-index;
                                    selected => {
                                        root.settings-changed();
                                    }
                                }
                            }
                            Row {
                                title: Tr.settings-resolution;
                                ComboBox {
                                    width: 260px;
                                    model: root.resolutions;
                                    current-index <=> root.resolution-index;
                                    selected => {
                                        root.settings-changed();
                                    }
                                }
                            }
                            Row {
                                title: Tr.settings-pause;
                                description: Tr.settings-pause-desc;
                                ComboBox {
                                    width: 260px;
                                    model: root.pause-options;
                                    current-index <=> root.pause-index;
                                    selected => {
                                        root.pause-changed();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 10px;
                    }
                    SectionTitle {
                        text: Tr.settings-appearance;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Row {
                            title: Tr.settings-fit;
                            ComboBox {
                                width: 260px;
                                model: root.fits;
                                current-index <=> root.fit-index;
                                selected => {
                                    root.display-changed();
                                }
                            }
                        }
                        if root.is-windows: Row {
                            title: Tr.settings-screens;
                            ComboBox {
                                width: 260px;
                                model: root.screen-options;
                                current-index <=> root.screens-index;
                                selected => {
                                    root.display-changed();
                                }
                            }
                        }
                        Row {
                            title: Tr.settings-caption;
                            description: Tr.settings-caption-desc;
                            Switch {
                                checked <=> root.caption;
                                toggled => {
                                    root.display-changed();
                                }
                            }
                        }
                        if root.caption: Row {
                            title: Tr.settings-caption-position;
                            ComboBox {
                                width: 260px;
                                model: root.corners;
                                current-index <=> root.corner-index;
                                selected => {
                                    root.display-changed();
                                }
                            }
                        }
                        Row {
                            title: Tr.settings-save;
                            description: Tr.settings-save-desc;
                            Switch {
                                checked <=> root.save-copies;
                                toggled => {
                                    root.settings-changed();
                                }
                            }
                        }
                    }
                    if root.is-windows: Rectangle {
                        height: 10px;
                    }
                    if root.is-windows: SectionTitle {
                        text: Tr.settings-admin;
                    }
                    if root.is-windows: VerticalLayout {
                        VerticalLayout {
                            spacing: 4px;
                            Row {
                                title: Tr.settings-admin-title;
                                description: Tr.settings-admin-desc;
                                Button {
                                    text: Tr.settings-admin-button;
                                    enabled: !root.busy;
                                    clicked => {
                                        root.confirm-admin = true;
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 10px;
                    }
                    SectionTitle {
                        text: Tr.settings-data;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Row {
                            title: Tr.settings-clear;
                            description: Tr.settings-clear-desc;
                            Button {
                                text: Tr.settings-clear-button;
                                enabled: !root.busy;
                                clicked => {
                                    root.confirm-remove = 1;
                                }
                            }
                        }
                        if root.is-windows && root.machine-setup: Row {
                            title: Tr.settings-unsetup;
                            description: Tr.settings-unsetup-desc;
                            Button {
                                text: Tr.settings-clear-button;
                                enabled: !root.busy;
                                clicked => {
                                    root.confirm-remove = 2;
                                }
                            }
                        }
                    }
                    if root.baseline-text != "": Text {
                        text: root.baseline-text;
                        font-size: 12px;
                        wrap: word-wrap;
                        color: Palette.foreground.transparentize(0.35);
                    }
                }
            }

            // About
            if root.page == 3: VerticalLayout {
                padding: 32px;
                padding-top: 24px;
                spacing: 16px;
                alignment: start;
                Text {
                    text: Tr.nav-about;
                    font-size: 28px;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    Image {
                        source: @image-url("../../../assets/icon-64.png");
                        width: 64px;
                        height: 64px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Chirp Wallpaper";
                            font-size: 20px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                        Text {
                            text: root.version;
                            color: Palette.foreground.transparentize(0.35);
                        }
                    }
                }
                Text {
                    text: Tr.about-text;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: Tr.about-website;
                        clicked => {
                            root.open-website();
                        }
                    }
                    Button {
                        text: Tr.about-source;
                        clicked => {
                            root.open-source();
                        }
                    }
                }
            }

            // Short confirmation at the bottom
            if root.toast != "": Rectangle {
                y: parent.height - self.height - 20px;
                x: (parent.width - self.width) / 2;
                width: min(toast-text.preferred-width + 40px, parent.width - 40px);
                height: toast-text.preferred-height + 20px;
                border-radius: 6px;
                background: Palette.foreground;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000040;
                toast-text := Text {
                    x: 20px;
                    width: parent.width - 40px;
                    text: root.toast;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Palette.background;
                }
            }
        }
    }

    // Explain what "set up for all users" does before Windows asks for rights
    if root.confirm-admin: Rectangle {
        background: #00000060;
        TouchArea { }
        Rectangle {
            width: min(560px, parent.width - 48px);
            height: dialog.preferred-height;
            border-radius: 8px;
            background: Palette.background;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;
            dialog := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: Tr.admin-confirm-title;
                    font-size: 20px;
                    font-weight: 600;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                Text {
                    text: Tr.admin-confirm-intro;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                for step in [Tr.admin-step-copy, Tr.admin-step-lock, Tr.admin-step-signin]: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "•";
                        color: Palette.foreground;
                    }
                    Text {
                        text: step;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        color: Palette.foreground;
                    }
                }
                Text {
                    text: Tr.admin-confirm-uac;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.35);
                }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: Tr.cancel;
                        clicked => {
                            root.confirm-admin = false;
                        }
                    }
                    Button {
                        text: Tr.admin-confirm-ok;
                        primary: true;
                        clicked => {
                            root.confirm-admin = false;
                            root.setup-machine();
                        }
                    }
                }
            }
        }
    }
    // Ask before removing anything.
    if root.confirm-remove != 0: Rectangle {
        background: #00000060;
        TouchArea { }
        Rectangle {
            width: min(520px, parent.width - 48px);
            height: removal.preferred-height;
            border-radius: 8px;
            background: Palette.background;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;
            removal := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: root.confirm-remove == 1 ? Tr.clear-confirm-title : Tr.unsetup-confirm-title;
                    font-size: 20px;
                    font-weight: 600;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                Text {
                    text: root.confirm-remove == 1 ? Tr.clear-confirm-text : Tr.unsetup-confirm-text;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: Tr.cancel;
                        clicked => {
                            root.confirm-remove = 0;
                        }
                    }
                    Button {
                        text: Tr.remove-button;
                        primary: true;
                        clicked => {
                            if root.confirm-remove == 1 {
                                root.confirm-remove = 0;
                                root.clear-data();
                            } else {
                                root.confirm-remove = 0;
                                root.remove-machine();
                            }
                        }
                    }
                }
            }
        }
    }
}
