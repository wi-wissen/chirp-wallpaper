# Chirp Wallpaper — עברית (תרגום ראשוני, לבדיקה)
updated = הוגדרה תמונה חדשה: { $title }
already-current = התמונה מעודכנת: { $title }
unchanged = לא ניתן היה לטעון תמונה חדשה ({ $reason }). התמונה הנוכחית נשארת.
unchanged-kept = עדיין מוצגת: { $title } מתאריך { $date }.
paused = החלפת התמונה מושהית עד { $date }.
warning-desktop = לא ניתן היה לשנות את רקע שולחן העבודה: { $reason }
warning-lockscreen = לא ניתן היה לשנות את מסך הנעילה: { $reason }
status-heading = התמונה הנוכחית
label-date = תאריך
label-region = אזור
label-copyright = זכויות יוצרים
label-more = מידע נוסף
label-last-success = עדכון אחרון
label-last-error = שגיאה אחרונה
label-baseline = תמונת בסיס
none = אין
seal-done = תמונת הבסיס נשמרה: { $title } ({ $date })
install-done = החלפת התמונה האוטומטית הוגדרה.
uninstall-done = החלפת התמונה האוטומטית הוסרה.
config-saved = ההגדרות נשמרו: { $file }
needs-admin = נדרשות הרשאות מנהל. יש להריץ שוב כמנהל.
not-supported = לא זמין במערכת זו.
error = שגיאה: { $reason }
